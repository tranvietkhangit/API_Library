@model IEnumerable<Library_Web.Models.DTO.BookDTO>

<h2>
    List all books
</h2>

<form asp-controller="Books" asp-action="Index" method="get">

    <label>Tìm kiếm sách: </label>

    <select name="filterOn" id="filterOn">
        <option value="title">Tiêu đề</option>
        <option value="author">Tác giả</option>
        <option value="publisher">Nhà xuất bản</option>
    </select>

    <input type="text"
           name="filterQuery"
           placeholder="Nhập từ khóa..." />

    <label>Sắp xếp:</label>

    <select name="sortBy" id="sortBy">
        <option value="title">Tiêu đề</option>
        <option value="rate">Đánh giá</option>
    </select>

    <label>Tăng dần: </label>
    <input type="radio"
           name="isAscending"
           value="true"
           checked />

    <label>Giảm dần: </label>
    <input type="radio"
           name="isAscending"
           value="false" />

    <input type="submit"
           value="Search" />

</form>

<br />
<a asp-controller="Login"
   asp-action="Logout"
   class="btn btn-danger">
    Logout
</a>
@if (Context.Session.GetString("Role") == "Write")
{
    <a class="btn btn-primary"
       asp-controller="Books"
       asp-action="addBook">
        Add new book
    </a>
}
<br />
<br />

<table class="table">

    <tr>
        <th>Id code</th>
        <th>Title</th>
        <th>Author</th>
        <th>Publisher</th>
        <th>Rating</th>
        <th>Detail</th>

        @if (Context.Session.GetString("Role") == "Write")
        {
            <th>Edit</th>
            <th>Delete</th>
        }
    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>
                @item.Id
            </td>

            <td>
                @item.Title
            </td>

            <td>
                @if (item.AuthorNames != null)
                {
                    foreach (var author in item.AuthorNames)
                    {
                        @author
                        <br />
                    }
                }
            </td>

            <td>
                @item.PublisherName
            </td>

            <td>
                @if (item.Rate.HasValue)
                {
                    @for (var i = 0; i < item.Rate.Value; i++)
                    {
                        <span>★</span>
                    }
                }
                else
                {
                    <span>Chưa đánh giá</span>
                }
            </td>

            <td>
                <a asp-controller="Books"
                   asp-action="listBook"
                   asp-route-id="@item.Id">
                    Detail
                </a>
            </td>

            @if (Context.Session.GetString("Role") == "Write")
            {
                <td>
                    <a asp-controller="Books"
                       asp-action="editBook"
                       asp-route-id="@item.Id">
                        Edit
                    </a>
                </td>

                <td>
                    <a asp-controller="Books"
                       asp-action="delBook"
                       asp-route-id="@item.Id">
                        Delete
                    </a>
                </td>
            }

        </tr>
    }

</table>