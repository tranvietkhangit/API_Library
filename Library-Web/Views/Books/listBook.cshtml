@model Library_Web.Models.DTO.BookDTO

<h1>Thông tin sách:</h1>

<p>Id: @Model.Id</p>

<p>Tên sách: @Model.Title</p>

<p>Mô tả: @Model.Description</p>

<p>
    Tác giả:
    @if (Model.AuthorNames != null && Model.AuthorNames.Any())
    {
        foreach (var author in Model.AuthorNames)
        {
            <span>@author</span>
            <br />
        }
    }
    else
    {
        <span>Chưa có tác giả</span>
    }
</p>

<p>Nhà xuất bản: @Model.PublisherName</p>

<p>Thể loại: @Model.Genre</p>

<p>
    Trạng thái:
    @if (Model.IsRead == true)
    {
        <span>Đã đọc</span>
    }
    else
    {
        <span>Chưa đọc</span>
    }
</p>

<p>
    Đánh giá:
    @if (Model.Rate.HasValue)
    {
        <span>@Model.Rate</span>
    }
    else
    {
        <span>Chưa đánh giá</span>
    }
</p>

<p>Ngày đọc: @Model.DateRead</p>

<p>Ngày thêm: @Model.DateAdded</p>

@if (!string.IsNullOrEmpty(Model.CoverUrl))
{
    <p>
        Ảnh bìa:
        <br />
        <img src="@Model.CoverUrl"
             style="width:200px;" />
    </p>
}

<br />

<a asp-controller="Books"
   asp-action="Index">
    Quay lại danh sách
</a>